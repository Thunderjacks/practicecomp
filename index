    var groups = Object.keys(map[ev]);
    groups.forEach(function (g) {
      var list = dedupeRows(map[ev][g].slice().sort(function (a, b) { return a.place - b.place || a.name.localeCompare(b.name); }));
      if (groups.length > 1 || (g !== 'Everyone' && g !== 'All teams')) h += '<div class="ghead"><span class="tag">' + esc(g) + '</span></div>';
      h += limited(list, 3);
    });
  });
  if (execMode) h += '<div class="btnrow"><button class="small danger-outline" data-act="deleteArchive" data-comp="' + esc(c.id) + '">Delete this comp</button></div>';
  return h;
}
function renderPeopleSearch(q) {
  var by = {};
  archive.rows.forEach(function (r) { var k = normName(r.name); if (k.indexOf(q) === -1) return; (by[k] = by[k] || { name: r.name, div: r.div, rows: [] }).rows.push(r); });
  var keys = Object.keys(by).sort();
  if (!keys.length) return '<p class="empty">No results found for that name.</p>';
  var cm = {}; archive.comps.forEach(function (c) { cm[c.id] = c; });
  var h = '';
  keys.slice(0, 8).forEach(function (k) {
    var p = by[k], ids = {}, total = 0;
    p.rows.forEach(function (r) { ids[r.compId] = 1; total += r.points; });
    p.rows.sort(function (a, b) {
      var da = (cm[a.compId] || {}).date || '', db = (cm[b.compId] || {}).date || '';
      return da < db ? 1 : da > db ? -1 : a.event.localeCompare(b.event);
    });
    h += '<div class="person-results"><h3>' + chip(p.div) + ' ' + esc(p.name) + '</h3><p class="hint">' + p.rows.length + (p.rows.length === 1 ? ' result' : ' results') + ' in ' + Object.keys(ids).length +
      (Object.keys(ids).length === 1 ? ' comp' : ' comps') + ' · ' + total + ' points</p><div class="tbl"><table><tr><th>Comp</th><th>Event</th><th>Place</th><th>Score</th><th>Pts</th></tr>' +
      p.rows.map(function (r) {
        var c = cm[r.compId] || { title: '', date: '' };
        return '<tr><td>' + esc(c.date) + '<small>' + esc(c.title) + '</small></td><td>' + esc(r.event) + '<small>' + esc(r.group) + (r.partner ? ' · with ' + esc(r.partner) : '') + '</small></td><td>' + r.place +
          '</td><td>' + esc(fmtScore(r.score, r.dir)) + '</td><td>' + r.points + '</td></tr>';
      }).join('') + '</table></div></div>';
  });
  if (keys.length > 8) h += '<p class="hint">Showing 8 of ' + keys.length + ' matches. Type more of the name to narrow it down.</p>';
  return h;
}
function renderArchive() {
  var el = $('archiveBody');
  if (archiveLoading && !archive) { el.className = 'loading'; el.textContent = 'Loading…'; return; }
  el.className = '';
  if (!archive) { el.innerHTML = '<p class="empty">Past comps could not be loaded. Tap Refresh to try again.</p>'; return; }
  var q = normName($('archiveSearch').value);
  if (q) { el.innerHTML = renderPeopleSearch(q); return; }
  if (!archive.comps.length) { el.innerHTML = '<p class="empty">No archived comps yet. Results show up here after an exec finishes a comp.</p>'; return; }
  el.innerHTML = archive.comps.map(function (c) {
    var rows = archive.rows.filter(function (r) { return r.compId === c.id; });
    return '<details class="past"><summary><b>' + esc(c.title) + '</b> <span class="tag">' + esc(c.date) + '</span> <span class="tag">' + c.people + ' people</span></summary><div class="past-body">' + compDetail(c, rows) + '</div></details>';
  }).join('');
}
async function loadArchive(force) {
  if (!configured()) { showMsg('This page is not connected to its Google Sheet yet.', 'err'); return; }
  if (archive && !force) { renderArchive(); return; }
  archiveLoading = true; renderArchive();
  try { var res = await apiGet('?view=archive'); if (res.ok) archive = res.archive; }
  catch (e) { showMsg("Couldn't load past comps.", 'err'); }
  archiveLoading = false; renderArchive();
}

/* ---------------- actions ---------------- */
async function doCheckin() {
  if (sending) return;
  var name = $('nameInput').value.trim();
  if (!name) { showMsg('Enter your name first.', 'err'); return; }
  var d = document.querySelector('input[name=div]:checked');
  if (!d) { showMsg("Pick Women's or Open.", 'err'); return; }
  var events = Array.prototype.map.call($('checkinEvents').querySelectorAll('input:checked'), function (i) { return i.value; });
  if (!events.length) { showMsg('Pick at least one event.', 'err'); return; }
  sending = true; $('checkinBtn').disabled = true;
  var res = await send({ action: 'checkin', name: name, div: d.value, events: events }, function (r) { return r.updated ? 'Check-in updated.' : 'Checked in! Good luck out there.'; });
  sending = false;
  if (res) {
    lsSet('lsName', name); lsSet('lsDiv', d.value);
    Array.prototype.forEach.call($('checkinEvents').querySelectorAll('input:checked'), function (i) { i.checked = false; });
  }
  renderAll();
}
async function doPair(evName, aId, bId) {
  var ev = null; comp.events.forEach(function (e) { if (e.name === evName) ev = e; });
  var a = null, b = null; checkins.forEach(function (c) { if (c.id === aId) a = c; if (c.id === bId) b = c; });
  var problem = pairProblem(ev, a, b);
  if (problem) { showMsg(problem, 'err'); return; }
  pairSel = null;
  renderTeams();
  await send({ action: 'pair', pin: execPin, event: evName, a: aId, b: bId }, 'Paired.');
  renderAll();
}
async function doUnlock() {
  var pin = $('pinInput').value;
  if (!pin) return;
  if (!configured()) { showMsg('Not connected to the Google Sheet yet.', 'err'); return; }
  setBusy(1);
  try {
    var res = await apiPost({ action: 'verify', pin: pin });
    setBusy(-1);
    if (res.ok) { execMode = true; execPin = pin; $('pinInput').value = ''; showMsg('Exec mode unlocked.', 'ok'); renderAll(); renderSetup(); }
    else showMsg(res.error || 'Wrong PIN.', 'err');
  } catch (e) { setBusy(-1); showMsg("Couldn't reach the server.", 'err'); }
}
async function doArchive() {
  if (!confirm('Finish this comp and archive the results? This clears the check-ins and scores. The results are saved under Past comps.')) return;
  var res = await send({ action: 'archive', pin: execPin }, function (r) { return 'Archived ' + r.archived + ' results.'; });
  if (res) { archive = null; tab = 'past'; renderAll(); renderSetup(); loadArchive(true); }
}

document.addEventListener('click', function (e) {
  var t = e.target.closest ? e.target.closest('[data-act]') : null;
  if (!t || t.dataset.act === 'score') return;
  var d = t.dataset;
  switch (d.act) {
    case 'tab': tab = d.tab; renderAll(); if (tab === 'past') loadArchive(false); break;
    case 'checkin': doCheckin(); break;
    case 'filter': rosterFilter = d.v; renderRoster(); break;
    case 'togglePerson': expandedPeople[d.id] = !expandedPeople[d.id]; renderRoster(); break;
    case 'toggleGroup': expandedGroups[d.key] = !expandedGroups[d.key]; renderScoreboard(); break;
    case 'toggleOverall': overallExpanded = !overallExpanded; renderScoreboard(); break;
    case 'overallTab': overallTab = d.v; overallExpanded = false; renderScoreboard(); break;
    case 'unlock': doUnlock(); break;
    case 'lock': execMode = false; execPin = null; pairSel = null; renderAll(); break;
    case 'startComp':
      (async function () {
        var res = await send({ action: 'setComp', pin: execPin, comp: readSetup() }, 'Comp saved.');
        if (res) { renderAll(); renderSetup(); }
      })();
      break;
    case 'setDiv': send({ action: 'setDiv', pin: execPin, id: d.id, div: d.div }, 'Division changed.').then(renderAll); break;
    case 'removeCheckin':
      if (confirm('Remove this person from the comp (and any scores or teams they are in)?')) send({ action: 'removeCheckin', pin: execPin, id: d.id }, 'Removed.').then(renderAll);
      break;
    case 'pick':
      if (!pairSel || pairSel.event !== d.event) { pairSel = { event: d.event, id: d.id }; renderTeams(); }
      else if (pairSel.id === d.id) { pairSel = null; renderTeams(); }
      else doPair(d.event, pairSel.id, d.id);
      break;
    case 'autoPair': send({ action: 'autoPair', pin: execPin, event: d.event }, function (r) { return r.paired ? 'Paired ' + r.paired + (r.paired === 1 ? ' team.' : ' teams.') : 'No more valid pairs to make.'; }).then(renderAll); break;
    case 'unpair': send({ action: 'unpair', pin: execPin, event: d.event, teamId: d.team }, 'Unpaired.').then(renderAll); break;
    case 'archive': doArchive(); break;
    case 'resetComp':
      if (confirm('Discard ALL check-ins, teams and scores for this comp WITHOUT saving them? This cannot be undone.')) send({ action: 'reset', pin: execPin }, 'Comp data cleared.').then(renderAll);
      break;
    case 'reloadArchive': loadArchive(true); break;
    case 'deleteArchive':
      if (confirm('Permanently delete this archived comp and its results?')) {
        send({ action: 'deleteArchive', pin: execPin, compId: d.comp }, 'Deleted.').then(function (res) { if (res && res.archive) archive = res.archive; renderArchive(); });
      }
      break;
  }
});

document.addEventListener('change', function (e) {
  var t = e.target;
  if (t.closest && t.closest('#setupCard')) setupDirty = true;
  if (t.dataset && t.dataset.act === 'score') {
    var v = t.value === '' ? null : parseFloat(t.value);
    send({ action: 'setScore', pin: execPin, event: t.dataset.event, id: t.dataset.id, value: v }).then(renderAll);
  }
});
document.addEventListener('input', function (e) { if (e.target.closest && e.target.closest('#setupCard')) setupDirty = true; });

document.addEventListener('dragstart', function (e) {
  var t = e.target.closest ? e.target.closest('[data-act="pick"]') : null;
  if (t && e.dataTransfer) e.dataTransfer.setData('text/plain', JSON.stringify({ event: t.dataset.event, id: t.dataset.id }));
});
document.addEventListener('dragover', function (e) { if (e.target.closest && e.target.closest('[data-act="pick"]')) e.preventDefault(); });
document.addEventListener('drop', function (e) {
  var t = e.target.closest ? e.target.closest('[data-act="pick"]') : null;
  if (!t || !e.dataTransfer) return;
  e.preventDefault();
  try {
    var src = JSON.parse(e.dataTransfer.getData('text/plain'));
    if (src.event === t.dataset.event && src.id !== t.dataset.id) doPair(src.event, src.id, t.dataset.id);
  } catch (err) {}
});

var searchTimer = null;
$('searchInput').addEventListener('input', function () { clearTimeout(searchTimer); searchTimer = setTimeout(renderScoreboard, 150); });
$('archiveSearch').addEventListener('input', function () { clearTimeout(searchTimer); searchTimer = setTimeout(renderArchive, 150); });
$('pinInput').addEventListener('keydown', function (e) { if (e.key === 'Enter') doUnlock(); });

/* live refresh: skipped while someone is typing or a save is in flight */
setInterval(function () {
  if (document.hidden || !configured() || busy > 0 || tab !== 'today') return;
  var a = document.activeElement;
  if (a && (a.tagName === 'INPUT' || a.tagName === 'SELECT' || a.tagName === 'TEXTAREA')) return;
  loadAll(true);
}, POLL_MS);

/* remembered on this device only */
(function () {
  var n = lsGet('lsName'), dv = lsGet('lsDiv');
  if (n) $('nameInput').value = n;
  if (dv) { var r = document.querySelector('input[name=div][value="' + dv + '"]'); if (r) r.checked = true; }
})();
loadAll();
</script>
</body>
</html>
