/* ---------------- server ---------------- */
async function apiGet(query) {
  var r = await fetch(SCRIPT_URL + (query || ''));
  if (!r.ok) throw new Error('HTTP ' + r.status);
  return r.json();
}
async function apiPost(body) {
  // text/plain keeps this a "simple" request, which avoids CORS preflight trouble with Apps Script
  var r = await fetch(SCRIPT_URL, { method: 'POST', body: JSON.stringify(body) });
  if (!r.ok) throw new Error('HTTP ' + r.status);
  return r.json();
}
function applyState(s) {
  comp = normalizeComp(s.comp);
  checkins = (s.checkins || []).map(function (c) { return { id: c.id, name: c.name, div: c.div === 'W' ? 'W' : 'O', events: c.events || [] }; });
  teams = s.teams || {};
  scores = s.scores || {};
}
async function send(body, okMsg) {
  var my = ++seq;
  setBusy(1);
  try {
    var res = await apiPost(body);
    setBusy(-1);
    if (!res.ok) {
      if (res.error === 'bad pin') {
        execMode = false; execPin = null;
        showMsg('Exec session expired. Unlock again.', 'err');
        renderAll();
        return null;
      }
      showMsg(res.error || 'Something went wrong.', 'err');
      return null;
    }
    if (res.state && my > lastApplied) { lastApplied = my; applyState(res.state); }
    if (okMsg) showMsg(typeof okMsg === 'function' ? okMsg(res) : okMsg, 'ok');
    return res;
  } catch (e) {
    setBusy(-1);
    showMsg("Couldn't reach the server. Check your connection and try again.", 'err');
    return null;
  }
}
async function loadAll(quiet) {
  if (!configured()) {
    $('compSub').textContent = 'Not connected';
    showMsg('This page is not connected to its Google Sheet yet (SCRIPT_URL not set).', 'err');
    return;
  }
  var my = ++seq;
  try {
    var res = await apiGet();
    if (res.ok && my > lastApplied) { lastApplied = my; applyState(res.state); }
    renderAll();
    if (execMode && !setupDirty) renderSetup();
  } catch (e) {
    if (!quiet) { $('compSub').textContent = 'Offline'; showMsg("Couldn't load the latest data. Retrying automatically.", 'err'); }
  }
}

/* ---------------- shared render helpers ---------------- */
function pickAround(n, matchFn) {
  var set = {}, hits = {};
  for (var i = 0; i < n; i++) if (matchFn(i)) {
    hits[i] = true;
    for (var k = Math.max(0, i - AROUND); k <= Math.min(n - 1, i + AROUND); k++) set[k] = true;
  }
  return { idxs: Object.keys(set).map(Number).sort(function (a, b) { return a - b; }), hits: hits };
}
function topCut(places, limit) {            // places = ranks of already-sorted scored entries
  var cut = Math.min(limit, places.length);
  while (cut > 0 && cut < places.length && places[cut] === places[cut - 1]) cut++;
  return cut;
}
function rowsWithGaps(idxs, renderFn) {
  var html = '', prev = null;
  idxs.forEach(function (i) {
    if (prev !== null && i !== prev + 1) html += '<div class="gap">⋯</div>';
    html += renderFn(i);
    prev = i;
  });
  return html;
}

