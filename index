<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#002145">
<title>UBC Loggersports — Practice Comp</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders:wght@700;900&family=Source+Serif+4:wght@400;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#002145; --paper:#F3EEE1; --blue:#0055B7; --gold:#FFC72C; --green:#2E7D5B;
    --bark:#6E5440; --line:rgba(0,33,69,0.14); --danger:#a32d2d;
    --display:'Big Shoulders', sans-serif; --serif:'Source Serif 4', Georgia, serif; --mono:'Space Mono', monospace;
  }
  *{ box-sizing:border-box; }
  body{ margin:0; background:var(--paper); color:var(--ink); font-family:var(--serif); font-size:16px; line-height:1.45; }
  .wrap{ max-width:720px; margin:0 auto; padding:24px 16px 90px; }
  .hidden{ display:none !important; }
  h1{ font-family:var(--display); font-weight:900; text-transform:uppercase; font-size:2rem; line-height:1; margin:0 0 4px; }
  h2{ font-family:var(--display); font-weight:700; text-transform:uppercase; font-size:1.2rem; margin:0 0 12px; }
  h3{ font-family:var(--display); font-weight:700; text-transform:uppercase; font-size:1.05rem; margin:0 0 8px; }
  h4{ font-family:var(--display); font-weight:700; text-transform:uppercase; font-size:.95rem; margin:14px 0 6px; color:var(--blue); }
  .sub{ font-family:var(--mono); font-size:.74rem; letter-spacing:.06em; text-transform:uppercase; color:var(--bark); display:block; }
  .toprow{ display:flex; justify-content:space-between; align-items:flex-start; gap:10px; margin-bottom:14px; }
  .pill{ font-family:var(--mono); font-size:.66rem; letter-spacing:.07em; text-transform:uppercase; padding:5px 10px; border-radius:20px; white-space:nowrap; }
  .pill.exec{ background:var(--gold); color:var(--ink); }
  .pill.busy{ background:var(--ink); color:var(--paper); }

  .tabs{ display:flex; gap:6px; margin-bottom:16px; }
  .tabs button{ flex:1; background:transparent; color:var(--ink); border:2px solid var(--ink); }
  .tabs button.on{ background:var(--ink); color:var(--paper); }

  .card{ background:#fff; border:1px solid var(--line); border-radius:10px; padding:16px; margin-bottom:16px; }
  label{ font-family:var(--mono); font-size:.7rem; letter-spacing:.06em; text-transform:uppercase; color:var(--bark); display:block; margin-bottom:6px; }
  input[type=text], input[type=search], input[type=number], input[type=password], input[type=date], select{
    width:100%; padding:11px 12px; border:1px solid var(--line); border-radius:6px; font-family:var(--serif); font-size:1rem; margin-bottom:12px; background:var(--paper); color:var(--ink);
  }
  input:focus, select:focus, button:focus-visible{ outline:2px solid var(--blue); outline-offset:2px; }

  button{ font-family:var(--mono); font-size:.76rem; letter-spacing:.06em; text-transform:uppercase; padding:11px 18px; min-height:42px; border-radius:6px; border:1px solid var(--ink); background:var(--ink); color:var(--paper); cursor:pointer; }
  button.secondary{ background:transparent; color:var(--ink); }
  button.gold{ background:var(--gold); border-color:var(--gold); color:var(--ink); font-weight:700; }
  button.danger{ background:var(--danger); border-color:var(--danger); }
  button.danger-outline{ background:transparent; color:var(--danger); border-color:var(--danger); }
  button.small{ padding:6px 10px; min-height:32px; font-size:.66rem; }
  button.link{ background:none; border:none; color:var(--blue); padding:6px 0; min-height:0; text-decoration:underline; text-transform:none; letter-spacing:0; font-family:var(--serif); font-size:.9rem; }
  button:disabled{ opacity:.5; cursor:not-allowed; }
  .btnrow{ display:flex; gap:8px; flex-wrap:wrap; margin-top:6px; }

  /* division colour coding: Women's = gold, Open = blue, Mixed = green */
  .chip{ display:inline-block; font-family:var(--mono); font-weight:700; font-size:.62rem; letter-spacing:.05em; text-transform:uppercase; padding:2px 8px; border-radius:10px; vertical-align:middle; }
  .chip.W{ background:var(--gold); color:var(--ink); } .chip.O{ background:var(--blue); color:#fff; }
  .chip.X{ background:var(--green); color:#fff; }       .chip.A{ background:#d9d4c3; color:var(--ink); }
  .dot{ display:inline-block; width:10px; height:10px; border-radius:50%; margin-right:6px; vertical-align:baseline; }
  .dot.W{ background:var(--gold); box-shadow:0 0 0 1px var(--ink); } .dot.O{ background:var(--blue); }
  .tag{ font-family:var(--mono); font-size:.62rem; letter-spacing:.05em; text-transform:uppercase; color:var(--bark); font-weight:400; }

  /* check-in form */
  .seg{ display:flex; gap:8px; margin-bottom:12px; }
  .segopt{ flex:1; position:relative; margin:0; }
  .segopt input{ position:absolute; opacity:0; inset:0; }
  .segopt span{ display:block; text-align:center; padding:11px 8px; border:2px solid var(--line); border-radius:8px; font-family:var(--display); font-weight:700; font-size:1.05rem; text-transform:uppercase; color:var(--ink); background:var(--paper); }
  .segopt.W input:checked + span{ background:var(--gold); border-color:var(--ink); }
  .segopt.O input:checked + span{ background:var(--blue); border-color:var(--ink); color:#fff; }
  .segopt input:focus-visible + span{ outline:2px solid var(--blue); outline-offset:2px; }
  .events-grid{ display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:14px; }
  .ev-check{ display:flex; align-items:center; gap:8px; font-family:var(--serif); font-size:.92rem; text-transform:none; letter-spacing:0; color:var(--ink); padding:9px 10px; border:1px solid var(--line); border-radius:6px; background:var(--paper); margin:0; }
  .ev-check input{ width:auto; margin:0; }
  .ev-check .tag{ margin-left:auto; }

  /* roster */
  .filters{ display:flex; gap:6px; flex-wrap:wrap; margin-bottom:10px; }
  .filters button{ padding:6px 12px; min-height:34px; font-size:.68rem; background:transparent; color:var(--ink); }
  .filters button.on{ background:var(--ink); color:var(--paper); }
  .person{ border:1px solid var(--line); border-left:5px solid var(--blue); border-radius:6px; margin-bottom:6px; background:#fff; }
  .person.W{ border-left-color:var(--gold); }
  .person-head{ width:100%; display:flex; align-items:center; gap:8px; background:none; color:var(--ink); border:none; text-align:left; text-transform:none; letter-spacing:0; font-family:var(--serif); font-size:1rem; padding:10px; min-height:44px; }
  .person-head .pname{ flex:1; font-weight:600; }
  .person-head .pcount{ font-family:var(--mono); font-size:.66rem; color:var(--bark); text-transform:uppercase; }
  .person-body{ padding:0 10px 10px; }
  .evtag{ display:inline-block; font-size:.8rem; background:var(--paper); border:1px solid var(--line); border-radius:12px; padding:2px 9px; margin:0 5px 5px 0; }

  /* scoreboard */
  .event-block{ margin-bottom:20px; padding-bottom:6px; }
  .ghead{ display:flex; align-items:center; gap:8px; margin:8px 0 4px; }
  .gcount{ font-family:var(--mono); font-size:.64rem; color:var(--bark); text-transform:uppercase; }
  .row{ display:flex; flex-wrap:wrap; align-items:center; gap:4px 10px; padding:8px 0; border-bottom:1px solid var(--line); font-size:.95rem; }
  .row.hit{ background:#fff8dc; margin:0 -8px; padding:8px; border-radius:4px; }
  .place{ width:26px; font-family:var(--display); font-weight:900; font-size:1.2rem; text-align:center; color:var(--bark); }
  .row.first .place{ color:var(--blue); }
  .row.first .who{ font-weight:700; }
  .who{ flex:1 1 110px; min-width:0; }
  .nm{ white-space:nowrap; }
  .amp{ color:var(--bark); }
  .val{ display:flex; align-items:baseline; gap:8px; font-family:var(--mono); white-space:nowrap; margin-left:auto; }
  .pts{ font-size:.68rem; color:var(--green); }
  .pending{ color:var(--bark); font-size:.78rem; }
  .gap{ text-align:center; color:var(--bark); letter-spacing:.3em; padding:2px 0; }
  input.score-input{ width:88px; margin:0; padding:7px 8px; text-align:right; }
  .empty{ color:var(--bark); font-size:.9rem; font-style:italic; margin:6px 0; }
  .empty.small{ font-size:.82rem; }
  .loading{ font-family:var(--mono); font-size:.8rem; color:var(--bark); }
  .hint{ font-size:.82rem; color:var(--bark); margin:0 0 10px; }

  /* exec: pairing */
  .team-event{ margin-bottom:18px; }
  .team{ display:flex; align-items:center; gap:8px; padding:7px 0; border-bottom:1px solid var(--line); }
  .team .tnames{ flex:1; }
  .chips{ display:flex; flex-wrap:wrap; gap:8px; margin:8px 0; }
  .pchip{ text-transform:none; letter-spacing:0; font-family:var(--serif); font-size:.95rem; padding:8px 14px; min-height:42px; border-radius:22px; background:#fff; color:var(--ink); border:2px solid var(--blue); cursor:pointer; }
  .pchip.W{ border-color:var(--gold); background:#fff8dc; }
  .pchip.sel{ background:var(--ink); color:var(--paper); border-color:var(--ink); }
  .pchip.dim{ opacity:.35; }
  .evset{ border-bottom:1px solid var(--line); padding:8px 0; }
  .evname{ display:flex; align-items:center; gap:8px; text-transform:none; letter-spacing:0; font-family:var(--serif); font-size:1rem; color:var(--ink); margin:0 0 4px; }
  .evname input, .opt input{ width:auto; margin:0; }
  .evopts{ display:flex; flex-wrap:wrap; gap:8px 14px; align-items:center; padding-left:26px; }
  .opt{ display:flex; align-items:center; gap:6px; text-transform:none; letter-spacing:0; font-family:var(--serif); font-size:.85rem; margin:0; color:var(--ink); }
  .evopts select{ width:auto; margin:0; padding:5px 8px; font-size:.82rem; }

  /* past comps */
  details.past{ border:1px solid var(--line); border-radius:8px; margin-bottom:8px; background:#fff; }
  details.past > summary{ padding:12px; cursor:pointer; list-style:none; }
  details.past > summary::-webkit-details-marker{ display:none; }
  details.past[open] > summary{ border-bottom:1px solid var(--line); }
  .past-body{ padding:4px 12px 12px; }
  details.more > summary{ cursor:pointer; color:var(--blue); font-size:.88rem; padding:6px 0; }
  .person-results{ margin-bottom:18px; }
  .tbl{ overflow-x:auto; }
  table{ width:100%; border-collapse:collapse; font-size:.86rem; }
  th{ text-align:left; font-family:var(--mono); font-size:.62rem; letter-spacing:.06em; text-transform:uppercase; color:var(--bark); border-bottom:1px solid var(--line); padding:6px 8px 6px 0; }
  td{ padding:8px 8px 8px 0; border-bottom:1px solid var(--line); vertical-align:top; }
  td small{ color:var(--bark); display:block; }

  #msgSlot{ position:fixed; left:12px; right:12px; bottom:12px; z-index:50; max-width:696px; margin:0 auto; pointer-events:none; }
  .msg{ font-size:.9rem; padding:12px 14px; border-radius:8px; box-shadow:0 4px 18px rgba(0,33,69,.25); pointer-events:auto; }
  .msg.err{ background:#fcebeb; color:#791f1f; border:1px solid #e8b4b4; }
  .msg.ok{ background:#eaf3de; color:#27500a; border:1px solid #b9d79a; }
  @media (max-width:420px){ .events-grid{ grid-template-columns:1fr; } }
  @media (prefers-reduced-motion: reduce){ *{ transition:none !important; } }
</style>
</head>
<body>
<div class="wrap">

  <div class="toprow">
    <div>
      <h1>Practice Comp</h1>
      <span class="sub" id="compSub">Loading…</span>
    </div>
    <div id="statusSlot"></div>
  </div>

  <div class="tabs" role="tablist">
    <button data-act="tab" data-tab="today" class="on" id="tabBtnToday">Today's comp</button>
    <button data-act="tab" data-tab="past" id="tabBtnPast">Past comps</button>
  </div>

  <!-- ===================== TODAY ===================== -->
  <section id="tab-today">

    <div class="card" id="checkinCard">
      <h2>Check in</h2>
      <label for="nameInput">Your name</label>
      <input type="text" id="nameInput" placeholder="First and last name" maxlength="60" autocomplete="name">
      <label>Division</label>
      <div class="seg" id="divPick">
        <label class="segopt W"><input type="radio" name="div" value="W"><span>Women's</span></label>
        <label class="segopt O"><input type="radio" name="div" value="O"><span>Open</span></label>
      </div>
      <label>Events you're doing today</label>
      <div class="events-grid" id="checkinEvents"></div>
      <button id="checkinBtn" data-act="checkin">Check in</button>
    </div>

    <div class="card" id="rosterCard">
      <h2>Checked in <span class="tag" id="rosterCount"></span></h2>
      <div class="filters" id="rosterFilters">
        <button data-act="filter" data-v="ALL" class="on">All</button>
        <button data-act="filter" data-v="W">Women's</button>
        <button data-act="filter" data-v="O">Open</button>
      </div>
      <div id="rosterList" class="loading">Loading…</div>
    </div>

    <div class="card" id="scoreboardCard">
      <h2>Scoreboard</h2>
      <input type="search" id="searchInput" placeholder="Search your name to see your results" autocomplete="off">
      <div id="scoreboardList" class="loading">Loading…</div>
    </div>

    <!-- Exec sign-in lives at the bottom of the page -->
    <div class="card" id="execGateCard">
      <h2>Exec access</h2>
      <p class="hint">Members can ignore this. Execs: enter the PIN to set up the comp, pair teams, and enter scores.</p>
      <label for="pinInput">Exec PIN</label>
      <input type="password" id="pinInput" placeholder="Enter PIN" autocomplete="off">
      <button data-act="unlock">Unlock exec mode</button>
    </div>

    <div id="execArea" class="hidden">
      <div class="card" id="setupCard">
        <h2>Comp setup</h2>
        <label for="compTitle">Comp title</label>
        <input type="text" id="compTitle" placeholder="e.g. October Practice Comp" maxlength="80">
        <label for="compDate">Date</label>
        <input type="date" id="compDate">
        <label>Events</label>
        <p class="hint">Tick the events in this comp. By default Women's and Open are scored separately; untick that to put everyone on one board.</p>
        <div id="eventSetup"></div>
        <div class="btnrow"><button class="gold" data-act="startComp">Start / update comp</button></div>
      </div>

      <div class="card" id="teamsCard">
        <h2>Teams</h2>
        <div id="teamsBody"></div>
      </div>

      <div class="card" id="finishCard">
        <h2>Finish</h2>
        <p class="hint">When the comp is over, archive it. Results are saved under Past comps and the check-ins and scores are cleared for next time.</p>
        <div class="btnrow">
          <button class="gold" data-act="archive">Finish &amp; archive comp</button>
          <button class="danger-outline" data-act="resetComp">Discard without saving</button>
          <button class="secondary" data-act="lock">Lock exec mode</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PAST ===================== -->
  <section id="tab-past" class="hidden">
    <div class="card">
      <h2>Past comps</h2>
      <input type="search" id="archiveSearch" placeholder="Search a name to see all their results" autocomplete="off">
      <div id="archiveBody" class="loading">Loading…</div>
      <div class="btnrow"><button class="small secondary" data-act="reloadArchive">Refresh</button></div>
    </div>
  </section>

</div>
<div id="msgSlot" aria-live="polite"></div>

<script>
/* ========================================================================
   SETUP: paste your Google Apps Script web app URL below (ends in /exec).
   The exec PIN lives in the Apps Script, never in this file.
   ======================================================================== */
var SCRIPT_URL = https://script.google.com/macros/s/AKfycbxSiZm9xnV3Ie9BUAry_Px9x0aZlYxxtwhDY6WGWCUvEZdZlMpoE2RA2xIRBDJLnqYN/exec;

/* ===== SHARED RULES + SCORING (identical in the page and the Sheet script) ===== */
var CAT_LABEL = { W: "Women's", O: 'Open', X: 'Mixed', A: 'All' };
var POINTS = [10, 8, 6, 5, 4, 3, 2, 1];          // points for 1st..8th; everyone below gets 0
var GROUP_ORDER = ['W', 'O', 'X', 'A'];

// dir: 'asc' = lowest wins (times), 'desc' = highest wins (points).
// allowed (team events only): W = two Women's, O = two Open, X = one of each (mixed).
var EVENT_DEFS = [
  { name: 'Underhand Chop', type: 'individual', dir: 'asc' },
  { name: 'Pole Climb', type: 'individual', dir: 'asc' },
  { name: 'Stock Saw', type: 'individual', dir: 'asc' },
  { name: 'Axe Throwing', type: 'individual', dir: 'desc' },
  { name: 'Single Buck', type: 'individual', dir: 'asc' },
  { name: 'Double Buck', type: 'team', allowed: ['W', 'O', 'X'], dir: 'asc' },
  { name: 'Jack & Jill', type: 'team', allowed: ['X'], dir: 'asc' },
  { name: 'Pulp Toss', type: 'team', allowed: ['X'], dir: 'asc' },
  { name: 'Obstacle Pole', type: 'individual', dir: 'asc' },
  { name: 'Choker Race', type: 'individual', dir: 'asc' },
  { name: 'Speed Axe Throw', type: 'individual', dir: 'asc' },
  { name: 'Vertical Chop', type: 'individual', dir: 'asc' }
];

function findDef(name) {
  for (var i = 0; i < EVENT_DEFS.length; i++) if (EVENT_DEFS[i].name === name) return EVENT_DEFS[i];
  return null;
}

function mkEvent(name, split, dir) {
  var d = findDef(name);
  if (!d) return null;
  var team = d.type === 'team';
  var mixedOnly = team && d.allowed.length === 1 && d.allowed[0] === 'X';
  return {
    name: d.name,
    type: d.type,
    allowed: team ? d.allowed.slice() : null,
    split: mixedOnly ? true : split !== false,
    dir: (dir === 'asc' || dir === 'desc') ? dir : d.dir
  };
}

function isMixedOnly(ev) {
  return ev.type === 'team' && ev.allowed.length === 1 && ev.allowed[0] === 'X';
}

// Accepts the old format (events as plain strings + a directions map) as well as the new one.
function normalizeComp(c) {
  c = c || {};
  var events = [];
  (c.events || []).forEach(function (e) {
    var ev = typeof e === 'string' ? mkEvent(e, true, (c.directions || {})[e]) : (e ? mkEvent(e.name, e.split, e.dir) : null);
    if (ev) events.push(ev);
  });
  return { id: c.id || '', title: c.title || '', date: c.date || '', events: events };
}

function divOf(p) { return p && p.div === 'W' ? 'W' : 'O'; }
function normName(s) { return String(s || '').toLowerCase().replace(/\s+/g, ' ').trim(); }
function catOf(divA, divB) { return divA === divB ? divA : 'X'; }
function groupLabel(ev, key) {
  if (key === 'A') return ev.type === 'team' ? 'All teams' : 'Everyone';
  return CAT_LABEL[key];
}

function pairProblem(ev, a, b) {
  if (!ev || ev.type !== 'team') return 'That is not a team event.';
  if (!a || !b || a.id === b.id) return 'Pick two different people.';
  if (ev.allowed.indexOf(catOf(divOf(a), divOf(b))) === -1) {
    return isMixedOnly(ev)
      ? "This event is mixed pairs only (one Women's, one Open)."
      : "That pairing isn't allowed for this event.";
  }
  return '';
}

// Suggest pairs for people still unpaired: same division first, then mixed leftovers if allowed.
function autoPairPlan(ev, people) {
  var W = people.filter(function (p) { return divOf(p) === 'W'; });
  var O = people.filter(function (p) { return divOf(p) !== 'W'; });
  var okW = ev.allowed.indexOf('W') !== -1, okO = ev.allowed.indexOf('O') !== -1, okX = ev.allowed.indexOf('X') !== -1;
  var pairs = [];
  if (okW) while (W.length >= 2) pairs.push([W.shift(), W.shift()]);
  if (okO) while (O.length >= 2) pairs.push([O.shift(), O.shift()]);
  if (okX) while (W.length && O.length) pairs.push([W.shift(), O.shift()]);
  return pairs;
}

function hasScore(v) { return typeof v === 'number' && isFinite(v); }

function rankBoard(list) {
  list.sort(function (a, b) { return b.points - a.points || a.name.localeCompare(b.name); });
  list.forEach(function (p) {
    var better = 0;
    for (var i = 0; i < list.length; i++) if (list[i].points > p.points) better++;
    p.rank = better + 1;
  });
  return list;
}

// Ties share a place AND the points for that place (a two-way tie for 1st gives both 10 points; next is 3rd).
// Team members each get the full points for their team's finish.
function computeStandings(comp, checkins, teams, scores) {
  var byId = {};
  checkins.forEach(function (c) { byId[c.id] = c; });
  var totals = {}, scoredIds = {};

  var events = comp.events.map(function (ev) {
    var evScores = (scores && scores[ev.name]) || {};
    var entities = [];
    if (ev.type === 'team') {
      ((teams && teams[ev.name]) || []).forEach(function (t) {
        var a = byId[t.a], b = byId[t.b];
        if (!a || !b) return;
        entities.push({ id: t.id, members: [a.id, b.id], names: [a.name, b.name], divs: [divOf(a), divOf(b)], cat: catOf(divOf(a), divOf(b)) });
      });
    } else {
      checkins.forEach(function (c) {
        if (c.events.indexOf(ev.name) !== -1) entities.push({ id: c.id, members: [c.id], names: [c.name], divs: [divOf(c)], cat: divOf(c) });
      });
    }
    var map = {};
    entities.forEach(function (en) {
      var key = ev.split ? en.cat : 'A';
      if (!map[key]) map[key] = { key: key, label: groupLabel(ev, key), entries: [] };
      map[key].entries.push(en);
    });
    var groups = GROUP_ORDER.filter(function (k) { return map[k]; }).map(function (k) {
      var g = map[k];
      g.entries.forEach(function (en) { var s = evScores[en.id]; en.score = hasScore(s) ? s : null; });
      var scored = g.entries.filter(function (en) { return en.score !== null; });
      var pending = g.entries.filter(function (en) { return en.score === null; });
      scored.forEach(function (en) {
        var better = scored.filter(function (o) { return ev.dir === 'asc' ? o.score < en.score : o.score > en.score; }).length;
        en.place = better + 1;
        en.points = POINTS[better] || 0;
        en.members.forEach(function (id) { totals[id] = (totals[id] || 0) + en.points; scoredIds[id] = true; });
      });
      pending.forEach(function (en) { en.place = null; en.points = 0; });
      scored.sort(function (x, y) { return x.place - y.place || x.names[0].localeCompare(y.names[0]); });
      pending.sort(function (x, y) { return x.names[0].localeCompare(y.names[0]); });
      g.entries = scored.concat(pending);
      return g;
    });
    return { name: ev.name, type: ev.type, dir: ev.dir, split: ev.split, groups: groups };
  });

  var people = checkins.filter(function (c) { return scoredIds[c.id]; })
    .map(function (c) { return { id: c.id, name: c.name, div: divOf(c), points: totals[c.id] || 0 }; });
  function clone(list) { return list.map(function (p) { return { id: p.id, name: p.name, div: p.div, points: p.points }; }); }
  return {
    events: events,
    overall: {
      combined: rankBoard(clone(people)),
      women: rankBoard(clone(people.filter(function (p) { return p.div === 'W'; }))),
      open: rankBoard(clone(people.filter(function (p) { return p.div === 'O'; })))
    }
  };
}

// One row per person per scored result (used for the archive).
function buildResultRows(standings) {
  var rows = [];
  standings.events.forEach(function (ev) {
    ev.groups.forEach(function (g) {
      g.entries.forEach(function (en) {
        if (en.place === null) return;
        en.names.forEach(function (nm, i) {
          rows.push({ event: ev.name, group: g.label, place: en.place, name: nm, div: en.divs[i],
                      partner: en.names.length > 1 ? en.names[1 - i] : '', score: en.score, points: en.points, dir: ev.dir });
        });
      });
    });
  });
  return rows;
}
// Times are entered as seconds. Show 75.3 as "1:15.3". Highest-wins events (e.g. points) show plain numbers.
function fmtScore(score, dir) {
  if (score === null || score === undefined || score === '') return '';
  var n = Math.round(Number(score) * 100) / 100;
  if (!isFinite(n)) return '';
  function trim(x) { return String(x).replace(/(\.\d*?)0+$/, '$1').replace(/\.$/, ''); }
  if (dir !== 'asc') return trim(n);
  if (n >= 60) {
    var m = Math.floor(n / 60), r = Math.round((n - m * 60) * 100) / 100;
    return m + ':' + (r < 10 ? '0' : '') + trim(r);
  }
  return trim(n) + 's';
}
